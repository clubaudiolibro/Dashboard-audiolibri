{
  "name": "Guitar Tab Library",
  "short_name": "Tab Library",
  "description": "Archivio locale e offline di tablature per chitarra: categorie, CAGED, tonalità, modalità pratica, backup e PDF.",
  "lang": "it",
  "id": "./",
  "start_url": "./index.html#/archivio",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f4f5f8",
  "theme_color": "#2f5bd8",
  "categories": ["music", "education", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", ".pdf", ".jpg", ".jpeg", ".png", ".webp"] }]
    }
  }
}
